# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000    # Base URL (sitemap, robots.txt)
NEXT_PUBLIC_APP_NAME=Paddock                 # Display name

# ===========================================
# Auth — JWT Sessions
# ===========================================
JWT_SECRET=                                  # Required in production. Generate with: openssl rand -base64 32
ADMIN_EMAILS=                                # Optional, comma-separated. Defaults to the first account created.

# ===========================================
# Database — local SQLite file by default, Turso in production
# ===========================================
DATABASE_PATH=./data/paddock.db              # Local file (dev, tests, scripts)
TURSO_DATABASE_URL=                          # libsql://<db>-<org>.turso.io — set on Vercel; overrides DATABASE_PATH
TURSO_AUTH_TOKEN=                            # turso db tokens create paddock

# ===========================================
# Scheduled data refresh (Mon + Thu 00:01)
# ===========================================
# Vercel: vercel.json schedules GET /api/cron/refresh (UTC "1 5 * * 1,4" = 00:01 EST / 01:01 EDT).
CRON_SECRET=                                 # Required on Vercel. Random string; Vercel sends it as a Bearer token.
# Mac: `npm run schedule:install` (launchd agent running `npm run db:refresh`).
# Long-running Node server (`next start`): enable the in-app scheduler instead.
REFRESH_SCHEDULE_ENABLED=false               # true → refresh inside the Next.js server process
REFRESH_SCHEDULE="mon 00:01, thu 00:01"      # local time of the server; set TZ if needed
