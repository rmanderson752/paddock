# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000    # Base URL (sitemap, robots.txt)
NEXT_PUBLIC_APP_NAME=Paddock                 # Display name

# ===========================================
# Auth — JWT Sessions
# ===========================================
JWT_SECRET=                                  # Required in production. Generate with: openssl rand -base64 32
ADMIN_EMAILS=                                # Optional, comma-separated. Defaults to the first account created.

# ===========================================
# Database
# ===========================================
DATABASE_PATH=./data/paddock.db              # Optional. Defaults to ./data/paddock.db

# ===========================================
# Scheduled data refresh
# ===========================================
# On a Mac, `npm run schedule:install` sets up a launchd agent (Mon + Thu 00:01)
# that runs `npm run db:refresh` — no env vars needed. On a long-running server
# (`next start`), enable the in-app scheduler instead:
REFRESH_SCHEDULE_ENABLED=false               # true → refresh inside the Next.js server process
REFRESH_SCHEDULE="mon 00:01, thu 00:01"      # local time of the server; set TZ if needed
