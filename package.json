{
  "name": "paddock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:scrape": "npx tsx scripts/scrape-bat.ts",
    "db:clean": "npx tsx scripts/clean-data.ts",
    "db:stats": "npx tsx scripts/refresh-stats.ts",
    "db:refresh": "npx tsx scripts/refresh-db.ts",
    "db:export": "bash scripts/export-for-turso.sh",
    "db:listings": "npx tsx scripts/backfill-listings.ts",
    "db:extract": "npx tsx scripts/extract-details.ts",
    "eval:extraction": "npx tsx evals/extraction/run.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:studio": "npx drizzle-kit studio",
    "schedule:install": "bash scripts/schedule/install.sh",
    "schedule:uninstall": "bash scripts/schedule/uninstall.sh",
    "schedule:status": "bash scripts/schedule/status.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
